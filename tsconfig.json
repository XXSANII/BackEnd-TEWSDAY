{
  "compilerOptions": {
    "types": ["node", "jest"],
    "target": "ES2020",
    "lib": ["ES2022"],
    "module": "commonjs",
    "outDir": "./dist",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "incremental": true,
    "strict": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/**/*", "scripts/**/*", "knexfile.ts"],
  "exclude": ["node_modules", "dist"]
}

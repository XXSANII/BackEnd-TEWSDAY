# Copy to `.env` and fill in. Every key is parsed by `src/config/env.ts`, which also holds the defaults.
# Required at startup: JWT_SECRET, DATABASE_HOST, DATABASE_USERNAME, DATABASE_NAME.

# Application Environment
NODE_ENV=development
HOST=http://localhost
PORT=5001
ENABLE_CRON_JOBS=false

# Another Services Hosts
FRONTEND_HOST=http://localhost:3000

# Database Configuration
DATABASE_HOST=localhost
DATABASE_HOST_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_USER_PASSWORD=postgres
DATABASE_NAME=tewsday
# DATABASE_POOL_MIN=0          # optional; knexfile.ts picks a per-environment default when unset
# DATABASE_POOL_MAX=10

# Redis Configuration
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Object and Bucket Storage Configuration (S3-compatible; optional for local development)
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_FORCE_PATH_STYLE=false
OBJECT_STORAGE_BUCKET=tewsday-dev
OBJECT_STORAGE_BUCKET_ENDPOINT=

# JWT Configuration
JWT_SECRET=tewsday-dev-secret-super-long-random-string-for-jwt-signing

# Google OAuth Configuration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email Configuration (SMTP or Gmail)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
EMAIL_USER=
GOOGLE_APP_PASSWORD=

# AI Embedding Configuration
EMBEDDING_API_URL=
EMBEDDING_API_KEY=

# Platform Payee Configuration (for commission payments)
PLATFORM_PAYEE_USER_ID=

# File Handling Configuration
# 64 hex characters (32 bytes) for AES-256-GCM, e.g. `openssl rand -hex 32`
FILE_HIDDEN_STRING_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

{
  "name": "tewsday-api",
  "version": "1.0.0",
  "description": "TewsDay backend API (Express 5 + Knex + Redis)",
  "main": "index.js",
  "scripts": {
    "build": "tsc && tsc-alias",
    "start": "node dist/src/server.js",
    "dev": "nodemon --watch src --ext ts,json --exec tsx src/server.ts",
    "type-check": "tsc --noEmit",
    "db:migrate-up": "knex migrate:latest --knexfile knexfile.ts",
    "db:migrate-down": "knex migrate:rollback --knexfile knexfile.ts",
    "db:make-migration": "knex migrate:make -x ts --knexfile knexfile.ts",
    "db:seed": "knex seed:run --knexfile knexfile.ts",
    "db:seed:single": "knex seed:run --knexfile knexfile.ts --specific",
    "db:make-seed": "knex seed:make -x ts --knexfile knexfile.ts",
    "test": "jest --runInBand --passWithNoTests",
    "test:watch": "jest --watch"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.927.0",
    "@aws-sdk/s3-request-presigner": "^3.927.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "hpp": "^0.2.3",
    "ioredis": "^5.8.2",
    "jimp": "^1.6.0",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.3.0",
    "multer": "^2.0.2",
    "node-cron": "^4.2.1",
    "nodemailer": "^9.0.5",
    "pg": "^8.16.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/express-rate-limit": "^5.1.3",
    "@types/hpp": "^0.2.7",
    "@types/ioredis": "^4.28.10",
    "@types/jest": "^30.0.0",
    "@types/jimp": "^0.2.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.10.0",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^7.0.3",
    "@types/pg": "^8.15.6",
    "@types/uuid": "^10.0.0",
    "cpx2": "^8.0.2",
    "eslint": "^9.39.1",
    "jest": "^30.5.1",
    "nodemon": "^3.1.10",
    "prettier": "^3.6.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
